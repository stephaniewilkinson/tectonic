<form method="post" action="/programs/<%= @program.id %>/lifts"
      class="mt-3 flex flex-wrap items-end gap-2 border-t border-gray-100 pt-3">
  <%== csrf_tag("/programs/#{@program.id}/lifts") %>
  <input type="hidden" name="day_id" value="<%= day.id %>">
  <%# A name rather than an id, because the writer resolves a movement by name and creates
      one the account has never used before -- the same rule an assistant gets. %>
  <%# Sized to match the row this form writes: 44px tall, 16px type in the fields so iOS
      Safari does not zoom the page when one takes focus. See programs/_lift.erb. %>
  <input type="text" name="exercise" list="movements" required autocomplete="off"
         aria-label="movement" placeholder="movement"
         class="<%= field_style %> min-h-11 w-36 px-2 text-base">
  <input type="number" name="sets" value="3" min="1" required autocomplete="off"
         aria-label="sets" class="<%= field_style %> min-h-11 w-14 px-2 text-base">
  <span class="text-sm text-gray-400">&times;</span>
  <input type="number" name="reps" value="5" min="1" required autocomplete="off"
         aria-label="reps" class="<%= field_style %> min-h-11 w-14 px-2 text-base">
  <input type="number" name="top_weight" step="any" autocomplete="off"
         aria-label="pounds" placeholder="lb"
         class="<%= field_style %> min-h-11 w-20 px-2 text-base">
  <%# The effort a lift is written at, available from the moment it is written (#265) --
      "top set at RPE 8" is how an autoregulated lift is prescribed, and having to add the
      lift and then edit it to say so would make the target feel like an afterthought.

      This form still offers no percent_of_max box, unlike the edit row beside it. That
      omission is this form's existing shape and is not #265's to change. %>
  <input type="number" name="target_rpe" min="1" max="10" step="1" autocomplete="off"
         aria-label="target RPE" placeholder="RPE"
         class="<%= field_style %> min-h-11 w-16 px-2 text-base">
  <button type="submit" class="min-h-11 rounded-md bg-white px-3 text-sm font-semibold text-gray-700
                               shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">Add lift</button>
</form>
<datalist id="movements">
  <%- @exercises.each do |exercise| %>
    <option value="<%= exercise.name %>"></option>
  <%- end %>
</datalist>
