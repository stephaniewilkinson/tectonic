<%# The one thing a lifter does between weeks is change a load, so it is an inline form
    rather than a page of its own. Both prices are shown because they are exclusive: the
    writer refuses a lift that carries neither or both, and the message comes back here. %>
<%# min-h-11 is 44px, and it is unprefixed on purpose: Tailwind's sm: asks how wide the
    window is, not what is pointing at it, so resetting the height above 640px would hand
    the compact row back to a tablet held in landscape, which is all thumb. A pointer
    loses nothing to a taller box. text-base on the inputs is 16px, the threshold below
    which iOS Safari zooms the page when a field takes focus and leaves it zoomed; the
    buttons stay text-sm because nothing focuses them. %>
<form method="post" action="/programs/<%= @program.id %>/lifts/<%= lift.id %>"
      class="mt-3 flex flex-wrap items-end gap-2 border-t border-gray-100 pt-3">
  <%== csrf_tag("/programs/#{@program.id}/lifts/#{lift.id}") %>
  <span class="w-36 truncate text-sm font-medium text-gray-900"><%= lift.exercise.name %></span>
  <input type="number" name="sets" value="<%= lift.sets %>" min="1" autocomplete="off"
         aria-label="sets" class="min-h-11 w-14 rounded-md border-0 px-2 text-base shadow-sm ring-1 ring-inset ring-gray-300">
  <span class="text-sm text-gray-400">&times;</span>
  <input type="number" name="reps" value="<%= lift.reps %>" min="1" autocomplete="off"
         aria-label="reps" class="min-h-11 w-14 rounded-md border-0 px-2 text-base shadow-sm ring-1 ring-inset ring-gray-300">
  <input type="number" name="top_weight" value="<%= weight_label(lift.top_weight) %>" step="any" autocomplete="off"
         aria-label="pounds" placeholder="lb"
         class="min-h-11 w-20 rounded-md border-0 px-2 text-base shadow-sm ring-1 ring-inset ring-gray-300">
  <input type="number" name="percent_of_max" value="<%= lift.percent_of_max %>" step="any" autocomplete="off"
         aria-label="percent of max" placeholder="%"
         class="min-h-11 w-16 rounded-md border-0 px-2 text-base shadow-sm ring-1 ring-inset ring-gray-300">
  <button type="submit" class="min-h-11 rounded-md bg-white px-3 text-sm font-semibold text-gray-700
                               shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">Save</button>
</form>
<%# Deleting a lift cannot be undone, and this used to be a 16px run of red text four
    pixels of margin under the form holding Save -- the two likeliest taps on the row, with
    the irreversible one the smaller. It is a button now, 44px tall, and justify-end puts
    it at the opposite end of the row from Save rather than directly beneath it.
    It does not ask. It carried an hx-confirm for a while, with hx-boost to hand htmx a
    submission the browser would otherwise have made on its own, and that left this the
    only destructive action in the app that asked anything: deleting a whole session and
    every set in it goes through on one tap. One answer for both was worth more than the
    dialog and this is the answer, so the size and the distance from Save are the whole of
    what stands between a thumb and a lift that is gone, with no undo behind it. %>
<form method="post" action="/programs/<%= @program.id %>/lifts/<%= lift.id %>/delete"
      class="mt-2 flex justify-end">
  <%== csrf_tag("/programs/#{@program.id}/lifts/#{lift.id}/delete") %>
  <button type="submit" class="min-h-11 rounded-md bg-white px-3 text-sm font-semibold text-red-700
                               shadow-sm ring-1 ring-inset ring-red-200 hover:bg-red-50">Remove</button>
</form>
