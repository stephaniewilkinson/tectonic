<%# The one thing a lifter does between weeks is change a load, so it is an inline form
    rather than a page of its own. Both prices are shown because they are exclusive: the
    writer refuses a lift that carries neither or both, and the message comes back here. %>
<form method="post" action="/programs/<%= @program.id %>/lifts/<%= lift.id %>"
      class="mt-3 flex flex-wrap items-end gap-2 border-t border-gray-100 pt-3">
  <%= csrf_tag("/programs/#{@program.id}/lifts/#{lift.id}") %>
  <span class="w-36 truncate text-sm font-medium text-gray-900"><%= h(lift.exercise.name) %></span>
  <input type="number" name="sets" value="<%= h(lift.sets) %>" min="1" autocomplete="off"
         aria-label="sets" class="w-14 rounded-md border-0 px-2 py-1 text-sm shadow-sm ring-1 ring-inset ring-gray-300">
  <span class="text-sm text-gray-400">&times;</span>
  <input type="number" name="reps" value="<%= h(lift.reps) %>" min="1" autocomplete="off"
         aria-label="reps" class="w-14 rounded-md border-0 px-2 py-1 text-sm shadow-sm ring-1 ring-inset ring-gray-300">
  <input type="number" name="top_weight" value="<%= h(lift.top_weight) %>" step="any" autocomplete="off"
         aria-label="pounds" placeholder="lb"
         class="w-20 rounded-md border-0 px-2 py-1 text-sm shadow-sm ring-1 ring-inset ring-gray-300">
  <input type="number" name="percent_of_max" value="<%= h(lift.percent_of_max) %>" step="any" autocomplete="off"
         aria-label="percent of max" placeholder="%"
         class="w-16 rounded-md border-0 px-2 py-1 text-sm shadow-sm ring-1 ring-inset ring-gray-300">
  <button type="submit" class="rounded-md bg-white px-2 py-1 text-sm font-semibold text-gray-700
                               shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">Save</button>
</form>
<form method="post" action="/programs/<%= @program.id %>/lifts/<%= lift.id %>/delete" class="mt-1">
  <%= csrf_tag("/programs/#{@program.id}/lifts/#{lift.id}/delete") %>
  <button type="submit" class="text-xs text-red-700 hover:underline">remove</button>
</form>
