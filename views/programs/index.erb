<div class="mx-auto max-w-2xl">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-semibold text-gray-900">Programs</h1>
  </div>
  <p class="mt-2 text-sm text-gray-600">
    A block is weeks, each week days, each day the lifts you will do. Write one here or
    ask an assistant to; either way the app turns a week of it into real sessions.
  </p>

  <%- if @programs.empty? %>
    <p class="mt-6 text-sm text-gray-500">No blocks yet.</p>
  <%- else %>
    <ul class="mt-6 divide-y divide-gray-200 rounded-lg bg-white shadow ring-1 ring-gray-200">
      <%- @programs.each do |program| %>
        <li class="p-4">
          <a href="/programs/<%= program.id %>" class="text-sm font-semibold text-gray-900 hover:text-lime-700">
            <%= program.name %>
          </a>
          <p class="mt-1 text-sm text-gray-500">
            <%= program.weeks %> week<%= 's' unless program.weeks == 1 %>
            <%- if program.start_date %>
              <span class="mx-1">&middot;</span>from <%= program.start_date.strftime('%b %-d, %Y') %>
            <%- end %>
          </p>
        </li>
      <%- end %>
    </ul>
  <%- end %>

  <form method="post" action="/programs" class="mt-8 space-y-4">
    <%== csrf_tag('/programs') %>
    <h2 class="text-sm font-semibold text-gray-900">Start a block</h2>
    <div class="flex flex-wrap items-end gap-3">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-900">Name</label>
        <input type="text" id="name" name="name" required autocomplete="off"
               class="<%= field_style %> mt-1 w-52 px-3 py-1.5 text-gray-900">
      </div>
      <div>
        <label for="start_date" class="block text-sm font-medium text-gray-900">Starts</label>
        <input type="date" id="start_date" name="start_date" required autocomplete="off"
               class="<%= field_style %> mt-1 px-3 py-1.5 text-gray-900">
      </div>
      <button type="submit"
              class="<%= button_style %> bg-lime-500 px-3 py-1.5 text-sm font-semibold
                     text-gray-900 hover:bg-lime-600">Create</button>
    </div>
  </form>
</div>
