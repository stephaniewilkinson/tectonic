<%# One table of workouts, rendered once for the sessions still ahead and once for
    training already done, so the two lists cannot drift apart in how a row reads. %>
<div class="mt-4 flow-root">
  <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
      <table class="min-w-full divide-y divide-gray-300">
        <thead>
          <tr>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
              Date
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
              Sets
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
              Show
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
              Edit
            </th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
              Delete
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <%- workouts.each do |workout| %>
            <tr>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                <%= workout[:date].strftime('%b %d, %Y') %>
                <%- if workout.status == :skipped %>
                  <span class="ml-1 rounded bg-gray-100 px-1.5 py-0.5 text-xs text-gray-500">skipped</span>
                <%- end %>
                <%- if provenance(workout) %>
                  <div class="text-xs text-gray-400"><%= provenance(workout) %></div>
                <%- end %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= workout.sets.count %></td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                <a href="/workouts/<%= workout[:id] %>/">
                  Show
                </a>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                <a href="/workouts/<%= workout[:id] %>/edit/">
                  Edit
                </a>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <form action="/workouts/<%= workout[:id] %>/delete" method="post"
                      hx-post="/workouts/<%= workout[:id] %>/delete"
                      hx-target="closest tr"
                      hx-swap="outerHTML">
                  <%= csrf_tag("/workouts/#{workout[:id]}/delete") %>
                  <button type="submit" class="font-medium text-red-600 hover:text-red-800">Delete</button>
                </form>
              </td>
            </tr>
          <%- end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
