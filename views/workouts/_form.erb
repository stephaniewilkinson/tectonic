<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.6.6/datepicker.min.js"></script>

<form action="/workouts" method="post">
  <%== csrf_tag('/workouts') %>
  <div>
    <label for="date" class="block text-sm font-medium leading-6 text-gray-900">Date</label>
    <div class="mt-2">
      <div class="relative max-w-sm">
        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
          <svg aria-hidden="true" class="w-5 h-5 text-gray-500 dark:text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path></svg>
        </div>
        <%# Came in with Flowbite's datepicker example and kept its accent: this was the
            only field in the app that went blue-500 on focus while every other one went
            lime. The six dark: variants it arrived with went with it. There is no dark
            theme here -- layout.erb is bg-gray-100 whatever the device says -- and
            Tailwind's CDN defaults darkMode to media, so on a phone set to dark this one
            input drew grey with white text in the middle of a page that stayed light. %>
        <input autocomplete="on" value="<%= Date.today.strftime('%m/%d/%Y') %>" name="date" id="date" required datepicker datepicker-autohide datepicker-buttons type="text" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-lime-500 focus:border-lime-500 block w-full pl-10 p-2.5">
      </div>
      <input type="hidden" name="id" id="id" value="<%= @workout&.id || nil %>">
    </div>
  </div>
  <%# Optional, and the placeholder says what it is for rather than what to type: two
      sessions on one date were the same word twice in a calendar cell, and this is the
      only thing that tells them apart. Not required, because most days have one session
      and making somebody name it would be a field to clear rather than a field to fill.

      A generated session needs nothing here: it reads its program day's focus when this
      is blank, so leaving it empty keeps the day's name rather than erasing it. %>
  <div class="mt-4">
    <label for="name" class="block text-sm font-medium leading-6 text-gray-900">Name</label>
    <div class="mt-2">
      <input type="text" name="name" id="name" autocomplete="off" maxlength="120"
             value="<%= @workout&.name %>" placeholder="Morning lift"
                    class="<%= field_style %> block w-full max-w-sm py-1.5 text-gray-900 placeholder:text-gray-400 sm:text-sm sm:leading-6">
    </div>
  </div>
  <input type="submit" value="Save" class="<%= button_style %> mt-4 block bg-lime-500 px-3 py-2 text-center text-sm font-semibold text-white hover:bg-lime-600">
</form>
