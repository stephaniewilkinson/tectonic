<%# The watch's heart rate over this session. #656, and lib/tectonic/heart_rates.rb has the
    rules: figures, never verdicts, and always how much of the session they cover.

    The coverage line is the point of the box rather than a footnote. #579 found the watch
    samples every ten minutes until it notices a workout and every few seconds after, so a
    session where the lifter did not start one on the watch has a dense stretch that begins
    part way through, and every set before it is next to unmeasured. Saying the stretch in
    clock times beside the sets' own is what stops a blank early column reading as a flat heart.

    Fetched only when asked, by the button, never on a view (#560). %>
<%- if @heart %>
  <div class="mt-4 rounded-md border border-gray-300 bg-white px-4 py-3">
    <h2 class="text-sm font-semibold text-gray-900">Heart rate</h2>
    <%- if @heart_read == 'unreachable' %>
      <p class="mt-1 text-sm text-amber-800" role="alert">Withings did not answer. Try again in a minute.</p>
    <%- elsif @heart_read == 'none' %>
      <p class="mt-1 text-sm text-gray-700" role="status">Withings had no heart rate for this session.</p>
    <%- end %>
    <%- if @heart[:dense] %>
      <p class="mt-1 text-sm text-gray-700">
        The watch recorded heart rate every few seconds from
        <%== render('workouts/_clock_time', locals: { at: @heart[:dense].first }) %> to
        <%== render('workouts/_clock_time', locals: { at: @heart[:dense].last }) %>. The sets ran from
        <%== render('workouts/_clock_time', locals: { at: @heart[:session].first }) %> to
        <%== render('workouts/_clock_time', locals: { at: @heart[:session].last }) %>.
        Sets outside that stretch have a reading every ten minutes at most, or none.
      </p>
    <%- elsif @heart[:readings].positive? %>
      <p class="mt-1 text-sm text-gray-700">
        The watch recorded only <%= @heart[:readings] %> heart rate reading<%= 's' unless @heart[:readings] == 1 %>
        around this session, which is what it does when no workout is started on it.
      </p>
    <%- end %>
    <%- if @heart[:connected] %>
      <form method="post" action="/workouts/<%= @workout[:id] %>/withings/heart-rate" class="mt-2">
        <%== csrf_tag("/workouts/#{@workout[:id]}/withings/heart-rate") %>
        <button type="submit" class="<%= button_style %> min-h-11 border border-gray-300 bg-white px-3 text-sm
                                      font-medium text-gray-700 hover:bg-gray-50">
          <%= @heart[:readings].positive? ? 'Read it again' : 'Read heart rate from the watch' %>
        </button>
      </form>
    <%- end %>
  </div>
<%- end %>
