<%# Where the unlock email's link lands. One button, because the link is the proof and nothing
    else is asked -- `unlock_account_requires_password?` is Rodauth's default of false, since the
    person here may be exactly the one who forgot it. %>
<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-sm">
    <h1 class="text-center text-3xl font-semibold tracking-tight text-gray-900">Unlock your account</h1>
    <%== render('_form_error') %>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">
    <form method="post" role="form" id="unlock-account-form">
      <%== rodauth.csrf_tag %>
      <button type="submit" class="<%= button_style %> flex min-h-11 w-full items-center justify-center bg-lime-500 px-3 py-1.5 text-sm font-semibold leading-6 text-gray-900 hover:bg-lime-600">Unlock and sign in</button>
    </form>
  </div>
</div>
