<form action="/workouts/<%= @workout.id %>/sets/<%= @set.id %>" method="post">
  <%= csrf_tag("/workouts/#{@workout.id}/sets/#{@set.id}") %>
    <%# step="5" counted from this row's own weight, so the set it refused to change to
        depended on what it already was: a set at 138 could go to 143 but not to 140. step
        is 1 and min is 0 for the same reasons as on the session screen; the long version of
        the argument, including why it is not "any", is in views/workouts/_session_body.erb. %>
    <div>
      <label for="weight" class="block text-sm font-medium text-gray-900">Weight</label>
      <input type="number" id="weight" name="weight" autocomplete="off" min="0" step="1" inputmode="numeric"
        value="<%= @set&.weight || nil %>"
        class="mt-1 block w-full rounded-lg border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-lime-500 sm:text-sm sm:leading-6">
    </div>
    <div class="mt-3">
      <label for="reps" class="block text-sm font-medium text-gray-900">Reps</label>
      <input type="number" id="reps" name="reps" autocomplete="off" min="0" step="1" inputmode="numeric"
        value="<%= @set&.reps || nil %>"
        class="mt-1 block w-full rounded-lg border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-lime-500 sm:text-sm sm:leading-6">
    </div>
    <%# An unticked box sends nothing, and the route reads a missing parameter as false,
        so a box that does not arrive carrying the row's own state clears it on save. %>
    Completed? <input type="checkbox" id="is_completed" name="is_completed" <%= 'checked' if @set[:is_completed] %>><br>
    Warmup set? <input type="checkbox" id="is_warmup" name="is_warmup" <%= 'checked' if @set[:is_warmup] %>><br>
    <select id="exercise_id" name="exercise_id" class="mt-2 block w-full rounded-lg border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-lime-500 sm:text-sm sm:leading-6">
      <%= render('sets/_exercise_options') %>
    </select>
    <button type="submit" class="mt-2 rounded-lg bg-lime-500 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-lime-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-500">
        Save
  </button>
</form>
