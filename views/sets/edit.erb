<form action="/workouts/<%= @workout.id %>/sets/<%= @set.id %>/edit" method="post">
    <div>
      <label for="weight" class="block text-sm font-medium text-gray-900">Weight</label>
      <input type="number" id="weight" name="weight" autocomplete="off" step="5" inputmode="numeric"
        value="<%= @set&.weight || nil %>"
        class="mt-1 block w-full rounded-lg border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-lime-500 sm:text-sm sm:leading-6">
    </div>
    <div class="mt-3">
      <label for="reps" class="block text-sm font-medium text-gray-900">Reps</label>
      <input type="number" id="reps" name="reps" autocomplete="off" step="1" inputmode="numeric"
        value="<%= @set&.reps || nil %>"
        class="mt-1 block w-full rounded-lg border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-lime-500 sm:text-sm sm:leading-6">
    </div>
    Completed? <input type="checkbox" id="is_completed" name="is_completed"><br>
    Warmup set? <input type="checkbox" id="is_warmup" name="is_warmup"><br>
    <select id="exercise_id" name="exercise_id" class="mt-2 block w-full rounded-lg border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-lime-500 sm:text-sm sm:leading-6">
        <%- @exercises.each do |exercise| %>
        <option value="<%= exercise[:id] %>"><%= exercise[:name] %></option>
        <%- end %>
    </select>
    <button type="submit" class="mt-2 rounded-lg bg-lime-500 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-lime-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-500">
        Save
  </button>
</form>
