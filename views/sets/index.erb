<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-base font-semibold leading-6 text-gray-900">Sets</h1>
      <p class="mt-2 text-sm text-gray-700"><%= @workout[:date].strftime('%A %B %-d, %Y') %></p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
      <a href="/workouts/<%= @workout[:id] %>/sets/new" class="block rounded-md bg-lime-500 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-gray-500">Add a set</a>
    </div>
  </div>
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <table class="min-w-full divide-y divide-gray-300">
          <thead>
            <tr>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Exercise</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Weight</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Reps</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Warmup</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Done</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Edit</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Show</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <%- @workout.sets.each do |set| %>
              <tr>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-900"><%= set.exercise[:name] %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= set[:weight] %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= set[:reps] %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= set[:is_warmup] ? 'Warmup' : '—' %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= set[:is_completed] ? 'Done' : '—' %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm">
                  <a href="/workouts/<%= @workout[:id] %>/sets/<%= set[:id] %>/edit" class="font-medium text-lime-600 hover:text-lime-500">Edit</a>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm">
                  <a href="/workouts/<%= @workout[:id] %>/sets/<%= set[:id] %>" class="font-medium text-lime-600 hover:text-lime-500">Show</a>
                </td>
              </tr>
            <%- end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
