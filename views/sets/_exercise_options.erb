<%- @library_exercises, @own_exercises = @exercises.partition(&:library?) %>
<%# The movement the set is already on, so editing one opens on it. A menu with
    nothing marked submits its first option, which on the edit form would quietly
    move the set to whichever exercise happens to sort first. Nil on the new-set
    form, where there is no set yet and the first option is the right default. %>
<%# And on the new-set form, what new_set_prefill chose (#631); where that is nothing, a first
    option that is no movement at all, outside the groups so the search box never lists it, so
    that nothing is chosen until the lifter chooses. %>
<%- @chosen_exercise_id = @set ? @set[:exercise_id] : @prefill&.dig(:exercise_id) %>
<%- if @set.nil? && @chosen_exercise_id.nil? %>
  <option value="" selected>Choose a movement</option>
<%- end %>
<%- unless @library_exercises.empty? %>
  <optgroup label="Library">
    <%- @library_exercises.each do |exercise| %>
      <option value="<%= exercise[:id] %>" <%= 'selected' if exercise[:id] == @chosen_exercise_id %>><%= exercise[:name] %></option>
    <%- end %>
  </optgroup>
<%- end %>
<%- unless @own_exercises.empty? %>
  <optgroup label="Your exercises">
    <%- @own_exercises.each do |exercise| %>
      <option value="<%= exercise[:id] %>" <%= 'selected' if exercise[:id] == @chosen_exercise_id %>><%= exercise[:name] %></option>
    <%- end %>
  </optgroup>
<%- end %>
