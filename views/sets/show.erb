<div class="mx-auto max-w-md">
  <h1 class="text-3xl font-semibold text-gray-900">
    <%= @set.exercise[:name] %> &mdash; <%= weight_label(@set[:weight]) %> &times; <%= @set[:reps] %>
  </h1>
  <%- if provenance(@set) %>
    <p class="mt-1 text-xs text-gray-500"><%= provenance(@set) %></p>
  <%- end %>
  <dl class="mt-6 divide-y divide-gray-200 border-y border-gray-200 text-sm">
    <div class="flex justify-between py-3">
      <dt class="text-gray-500">Workout</dt>
      <dd>
        <a href="/workouts/<%= @set.workout[:id] %>" class="font-medium text-lime-700 hover:text-lime-800">
          <%= @set.workout[:date].strftime('%A %B %-d, %Y') %>
        </a>
      </dd>
    </div>
    <div class="flex justify-between py-3">
      <dt class="text-gray-500">Exercise</dt>
      <dd>
        <a href="/exercises/<%= @set.exercise[:id] %>" class="font-medium text-lime-700 hover:text-lime-800">
          <%= @set.exercise[:name] %>
        </a>
      </dd>
    </div>
    <div class="flex justify-between py-3">
      <dt class="text-gray-500">Weight</dt>
      <dd class="text-gray-900"><%= weight_label(@set[:weight]) %></dd>
    </div>
    <div class="flex justify-between py-3">
      <dt class="text-gray-500">Reps</dt>
      <dd class="text-gray-900"><%= @set[:reps] %></dd>
    </div>
    <%# The box the list and the record answer with. `Yes` and `No` read as a sentence
        here, which a box does not, and that sentence is what this gives up: a lifter
        who arrives from either of the other two screens should not have to learn a
        third way of reading the same two booleans on the way. %>
    <div class="flex justify-between py-3">
      <dt class="text-gray-500">Warmup</dt>
      <dd class="text-gray-900"><%== ticked(@set[:is_warmup], 'warmup') %></dd>
    </div>
    <div class="flex justify-between py-3">
      <dt class="text-gray-500">Completed</dt>
      <dd class="text-gray-900"><%== ticked(@set[:is_completed], 'completed') %></dd>
    </div>
  </dl>
</div>
