<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="mt-6 text-center text-2xl font-bold leading-9 tracking-tight text-gray-900">Authorize access</h2>
    <p class="mt-4 text-center text-sm text-gray-600">
      <span class="font-semibold text-gray-900"><%= h(@oauth.client.client_name || @oauth.client_id) %></span>
      wants to connect to your tectonic plates account.
    </p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-gray-200">
      <p class="text-sm font-medium text-gray-900">It is requesting permission to:</p>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-700">
        <% @oauth.scopes.each do |scope| %>
          <li><%= h(scope) %></li>
        <% end %>
      </ul>

      <p class="mt-4 text-sm text-gray-700">
        After you approve, you will be returned to
        <span class="font-semibold text-gray-900"><%= h(@oauth.redirect_host) %></span>.
      </p>

      <% if @oauth.client.loopback_only? %>
        <p class="mt-4 rounded-md bg-amber-50 p-3 text-sm text-amber-800 ring-1 ring-amber-200">
          Warning: this client receives the authorization at a loopback address on this
          device. Any program running locally could receive it. Only approve if you started
          this connection yourself.
        </p>
      <% end %>

      <form method="post" action="/authorize" class="mt-6 space-y-4">
        <%= csrf_tag('/authorize') %>
        <input type="hidden" name="response_type" value="code">
        <input type="hidden" name="client_id" value="<%= h(@oauth.client_id) %>">
        <input type="hidden" name="redirect_uri" value="<%= h(@oauth.redirect_uri) %>">
        <input type="hidden" name="scope" value="<%= h(@oauth.scopes.join(' ')) %>">
        <input type="hidden" name="state" value="<%= h(@oauth.state) %>">
        <input type="hidden" name="resource" value="<%= h(@oauth.resource) %>">
        <input type="hidden" name="code_challenge" value="<%= h(@oauth.code_challenge) %>">
        <input type="hidden" name="code_challenge_method" value="<%= h(@oauth.code_challenge_method) %>">
        <button type="submit" class="flex w-full justify-center rounded-md bg-lime-500 px-3 py-1.5 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-lime-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-500">Approve</button>
      </form>
    </div>
    <p class="mt-6 text-center text-sm text-gray-500">
      Not expecting this? Close this page and nothing will be shared.
    </p>
  </div>
</div>
