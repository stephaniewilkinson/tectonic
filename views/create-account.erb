<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-sm">
    <h2 class="text-center text-2xl font-bold leading-9 tracking-tight text-gray-900">Create your account</h2>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">
    <form method="post" class="space-y-8 rodauth" role="form" id="create-account-form" autocomplete="on">
    <%== rodauth.csrf_tag %>
      <div>
        <label for="email" class="block text-sm font-medium leading-6 text-gray-900">Email address</label>
        <div class="mt-2">
          <%# "username", not "email": the autofill vocabulary treats "email" as an
              address field and "username" as the account identifier a password manager
              keys the saved credential to, which is the job this field is doing. It is
              the same token the sign-in form uses, and it has to be -- what a manager
              saves here it offers back there only if both forms name the identifier the
              same way. The confirmation below keeps "email": it is the same address typed
              twice, not a second account name. %>
          <input id="email" name="login" type="email" autocomplete="username" required class="block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-lime-500 sm:text-sm sm:leading-6">
        </div>
      </div>
      <div>
        <label for="email-confirm" class="block text-sm font-medium leading-6 text-gray-900">Confirm email address</label>
        <div class="mt-2">
          <input id="email-confirm" name="login-confirm" type="email" autocomplete="email" required class="block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-lime-500 sm:text-sm sm:leading-6">
        </div>
      </div>
      <%# Both password boxes say "new-password". They said "off", which on a sign-up form
          is the instruction not to save the password -- and Safari and iOS Keychain obey
          it, so the phone declined to remember an account it had just watched being
          created. "new-password" is the opposite instruction: no such credential exists
          yet, offer to generate one and offer to keep it. The confirmation box carries
          the same token deliberately, because that is what lets a manager put the
          generated password into both boxes rather than into one and leave the form
          refusing to submit. %>
      <div>
        <label for="password" class="block text-sm font-medium leading-6 text-gray-900">Password</label>
        <div class="mt-2">
          <input id="password" name="password" type="password" autocomplete="new-password" required class="block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-lime-500 sm:text-sm sm:leading-6">
        </div>
      </div>
      <div>
        <label for="password-confirm" class="block text-sm font-medium leading-6 text-gray-900">Confirm password</label>
        <div class="mt-2">
          <input id="password-confirm" name="password-confirm" type="password" autocomplete="new-password" required class="block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-lime-500 sm:text-sm sm:leading-6">
        </div>
      </div>
      <div>
        <button type="submit" class="flex w-full justify-center rounded-md bg-lime-500 px-3 py-1.5 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-lime-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-500">Sign up</button>
      </div>
    </form>

    <p class="mt-10 text-center text-sm text-gray-500">
      Already have an account?
      <a href="/login" class="font-semibold leading-6 text-lime-500 hover:text-lime-500">Log in</a>
    </p>
  </div>
</div>
