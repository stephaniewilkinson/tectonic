<div class="<%= page_style(:wide) %>">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="<%= heading_style(:page) %>">Exercises</h1>
      <p class="mt-2 text-sm text-gray-700">Your movements and the built-in barbell library.</p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
      <a href="/exercises/new" class="<%= primary_button_style %> block text-center">Add a new exercise</a>
    </div>
  </div>
  <%# The library and then yours, each under its own label. DESIGN.md. It was one table with a
      Source column, so a lifter's own movements were found by reading down sixty library rows
      for the word "Yours". The order is the picker's (spec/the_order_movements_are_listed_in_
      spec.rb holds the two together); the label is what makes the second half findable. %>
  <%- [['Library', @exercises.select(&:library?)], ['Yours', @exercises.reject(&:library?)]].each do |title, exercises| %>
  <%- next if exercises.empty? %>
  <h2 class="<%= heading_style(:label) %> mt-8"><%= title %></h2>
  <div class="mt-3 overflow-x-auto <%= card_style %>">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="py-3 pl-4 pr-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500 sm:pl-6">Name</th>
              <th scope="col" class="px-3 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Training max</th>
              <th scope="col" class="px-3 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">Rest</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <%- exercises.each do |exercise| %>
              <tr>
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
                  <a href="/exercises/<%= exercise[:id] %>"
                     class="font-medium text-lime-700 hover:text-lime-800"><%= exercise[:name] %></a>
                  <%- if provenance(exercise) %>
                    <div class="text-xs text-gray-500"><%= provenance(exercise) %></div>
                  <%- end %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm">
                  <%- if (stated = @stated_maxes[exercise[:id]]) %>
                    <span class="font-medium tabular-nums text-gray-900"><%= weight_label(stated[:pounds]) %></span>
                    <span class="text-gray-500">lb</span>
                    <div class="text-xs text-gray-500">set <%= stated[:stated_at].strftime('%-d %b') %></div>
                  <%- else %>
                    <span class="text-gray-400">&mdash;</span>
                  <%- end %>
                </td>
                <%# Said through Timing.named, which is how the movement's own page and its
                    edit form both say it -- "180 seconds" and "3m" are the same fact, and two
                    spellings of it in one app is one too many.

                    `named` rather than `phrase`: this is a length a lifter typed, and phrase
                    drops the seconds above two minutes, so a rest of 150 read back as "2m" --
                    which is what 120 reads as too. Right for a measured turnaround, wrong for
                    somebody's own words. %>
                <td class="whitespace-nowrap px-3 py-4 text-sm">
                  <%- if (rest = @rests[exercise[:id]]) %>
                    <span class="font-medium tabular-nums text-gray-900">
                      <%= Tectonic::Timing.named(rest) %>
                    </span>
                  <%- else %>
                    <span class="text-gray-400">&mdash;</span>
                  <%- end %>
                </td>
              </tr>
            <%- end %>
          </tbody>
        </table>
  </div>
  <%- end %>
</div>
