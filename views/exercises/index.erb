<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-base font-semibold leading-6 text-gray-900">Exercises</h1>
      <p class="mt-2 text-sm text-gray-700">Your movements and the built-in barbell library.</p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
      <a href="/exercises/new" class="block rounded-md bg-lime-500 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-lime-600">Add a new exercise</a>
    </div>
  </div>
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <table class="min-w-full divide-y divide-gray-300">
          <thead>
            <tr>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Name</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Source</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <%- @exercises.each do |exercise| %>
              <tr>
                <td class="whitespace-nowrap px-3 py-4 text-sm">
                  <a href="/exercises/<%= exercise[:id] %>"
                     class="font-medium text-lime-600 hover:text-lime-500"><%= exercise[:name] %></a>
                  <%- if provenance(exercise) %>
                    <div class="text-xs text-gray-400"><%= provenance(exercise) %></div>
                  <%- end %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= exercise.library? ? 'Library' : 'Yours' %>
                </td>
              </tr>
            <%- end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
