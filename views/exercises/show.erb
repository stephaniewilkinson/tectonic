
<div class="text-3xl">
  Exercise:
  <%= @exercise[:name] %>
  <br>
</div>
<hr>
<%- if @exercise.account_id == @account_id %>
  <a class="button" href="/exercises/<%= @exercise[:id] %>/edit">Edit</a>
<%- else %>
  <span class="text-sm text-gray-500">Built-in exercise</span>
<%- end %>
<%- @sets.each do | set | %>
  <hr>
  reps: <%= set[:reps] %>
  <br>
  weight: <%= set[:weight] %>
  <br>
  date: <%= set.workout[:date].strftime('%b %d, %Y') %>
<%- end %>
