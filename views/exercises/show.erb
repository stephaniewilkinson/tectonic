<%# A lift with nothing but warmups recorded draws no chart, and a page that draws no
    chart is not worth half a megabyte of charting library, so the layout takes its cue
    from here rather than loading them for everyone. %>
<%- @charts = !@heaviest_by_day.empty? %>
<div class="mx-auto max-w-md">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-semibold text-gray-900"><%= @exercise[:name] %></h1>
    <%- if @exercise.account_id == @account_id %>
      <a href="/exercises/<%= @exercise[:id] %>/edit" class="rounded-md bg-lime-500 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-gray-500">Edit</a>
    <%- else %>
      <span class="rounded-md bg-gray-100 px-3 py-2 text-sm font-medium text-gray-500">Built-in exercise</span>
    <%- end %>
  </div>

  <%- if provenance(@exercise) %>
    <p class="mt-1 text-xs text-gray-400"><%= provenance(@exercise) %></p>
  <%- end %>

  <%- if @sets.empty? %>
    <p class="mt-6 text-sm text-gray-500">No sets logged yet.</p>
  <%- else %>
    <%- if @charts %>
      <div class="mt-6">
        <h2 class="text-sm font-semibold text-gray-900">Heaviest weight each day</h2>
        <%# discrete: true spaces the recorded days evenly instead of by the calendar,
            which is a deliberate trade and worth naming: a week between sessions and a
            five-month layoff now look identical on the axis, and only the labels say
            which happened. It is the right trade for this page, whose question is
            whether the weight is going up, and against a real calendar a lift trained
            in January and again in June draws two points either side of an empty plot.
            min: nil lets the axis fit the weights instead of starting at zero, which
            nobody lifts and which flattens a season of progress into the top inch. %>
        <%= line_chart(@heaviest_by_day, ytitle: 'Weight', curve: false, min: nil, discrete: true) %>
      </div>
    <%- end %>

    <table class="mt-6 min-w-full divide-y divide-gray-300">
      <thead>
        <tr>
          <th scope="col" class="py-3.5 pr-3 text-left text-sm font-semibold text-gray-900">Date</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Weight</th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Reps</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <%- @sets.each do |set| %>
          <tr>
            <td class="whitespace-nowrap py-4 pr-3 text-sm text-gray-500"><%= set.workout[:date].strftime('%b %d, %Y') %></td>
            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= set[:weight] %></td>
            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= set[:reps] %></td>
          </tr>
        <%- end %>
      </tbody>
    </table>
  <%- end %>
</div>
