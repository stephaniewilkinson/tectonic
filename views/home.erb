<div class="mx-auto max-w-3xl">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-3xl font-semibold text-gray-900">Welcome to Tectonic Plates</h1>
    <div class="flex gap-2">
      <a href="/workouts/new" class="rounded-md bg-lime-500 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-lime-600">Start a new workout</a>
      <a href="/workouts/" class="rounded-md bg-sky-800 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-lime-500">Continue a workout</a>
    </div>
  </div>

  <div class="mt-8 flex items-center justify-between">
    <%# Paging a month is the one thing this page is tapped for, and at 51x28 it was the
        smallest target on it. min-h-11 is the 44px a thumb is aimed at; px-3 buys eight
        more across, which is what an arrow and three characters of a month name need to
        clear 44 on that axis too without the two of them closing on the heading. %>
    <a href="/?month=<%= @previous.strftime('%Y-%m') %>" rel="prev"
       class="inline-flex min-h-11 items-center rounded-md px-3 py-2 text-sm text-gray-500 hover:bg-gray-100">
      &larr; <%= @previous.strftime('%b') %>
    </a>
    <h2 class="text-lg font-semibold text-gray-900"><%= @month.strftime('%B %Y') %></h2>
    <a href="/?month=<%= @following.strftime('%Y-%m') %>" rel="next"
       class="inline-flex min-h-11 items-center rounded-md px-3 py-2 text-sm text-gray-500 hover:bg-gray-100">
      <%= @following.strftime('%b') %> &rarr;
    </a>
  </div>

  <%- if @tally.empty? %>
    <p class="mt-2 text-center text-sm text-gray-500">Nothing trained or planned this month.</p>
  <%- else %>
    <p class="mt-2 text-center text-sm text-gray-500">
      <%= [[:performed, 'trained'], [:planned, 'planned'], [:skipped, 'missed']]
            .filter_map { |status, word| "#{@tally[status]} #{word}" if @tally[status] }.join(' &middot; ') %>
    </p>
  <%- end %>

  <div class="mt-4 grid grid-cols-7 gap-px rounded-t-lg bg-gray-200 text-center text-xs font-semibold leading-6 text-gray-500">
    <%- Tectonic::Calendar::DAY_NAMES.each do |name| %>
      <div class="bg-gray-50 py-2"><%= name %></div>
    <%- end %>
  </div>

  <div class="grid grid-cols-7 gap-px rounded-b-lg bg-gray-200 text-sm">
    <%- @weeks.each do |week| %>
      <%- week.each do |cell| %>
        <%# A day outside the month is still drawn, so a week that straddles a boundary
            reads as a week; it is just dimmed, because the month is what is being read. %>
        <div class="min-h-20 p-1 <%= cell[:in_month] ? 'bg-white' : 'bg-gray-50 text-gray-400' %>">
          <div class="text-right">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full text-xs
                         <%= 'bg-lime-500 font-semibold text-white' if cell[:today] %>">
              <%= cell[:date].day %>
            </span>
          </div>
          <%# Performed, planned and skipped are the words a workout already answers
              with. Skipped is the one a list cannot show: a missed session is simply
              absent there, and seeing the hole is the point of a calendar.

              "planned" is forty-six pixels of text at text-xs, and a seventh of a phone
              screen does not leave that much inside a cell -- at 375px it leaves about
              thirty -- so below sm the tint is the whole of what is drawn and the legend
              underneath is the key to it. The word stays in the markup rather than being
              dropped: sr-only keeps it in the accessibility tree at every width, which
              the title attribute it replaces could not do, because a title has no way of
              being reached by a thumb. Nothing else is inside the link on a phone, so
              min-h-11 is what holds it open to a thumb. %>
          <%- Tectonic::Calendar.entries(cell[:workouts]).each do |entry| %>
            <a href="/workouts/<%= entry[:id] %>"
               class="mt-1 flex min-h-11 items-center justify-center rounded px-1 text-xs
                      font-medium sm:min-h-6 <%= entry[:style] %>">
              <span class="sr-only sm:not-sr-only"><%= entry[:word] %></span>
            </a>
          <%- end %>
        </div>
      <%- end %>
    <%- end %>
  </div>

  <%# On a phone this is now the key to the grid rather than a footnote to it, so each
      swatch is the chip: the same tint, the same rounded rectangle, at a size that can be
      told apart from the two beside it. The saturated dots it replaces were a colour that
      appeared nowhere in the calendar they were meant to explain. %>
  <div class="mt-3 flex flex-wrap justify-center gap-4 text-xs text-gray-500">
    <span class="flex items-center gap-1.5">
      <span class="inline-block h-4 w-6 rounded bg-lime-100 ring-1 ring-inset ring-lime-800/25"></span>trained
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block h-4 w-6 rounded bg-sky-100 ring-1 ring-inset ring-sky-800/25"></span>planned
    </span>
    <span class="flex items-center gap-1.5">
      <span class="inline-block h-4 w-6 rounded bg-rose-100 ring-1 ring-inset ring-rose-800/25"></span>missed
    </span>
  </div>
</div>
