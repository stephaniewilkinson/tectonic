# Copy this file to .env and it runs as it stands. dotenv loads .env when the app is
# required, and the three values that are not commented out are real ones for a local
# development run rather than blanks to fill in -- a blank is worse than a missing
# variable here, because dotenv sets the name to "" and every fallback in this project
# tests for nil, so an empty DATABASE_URL reaches Sequel.connect and raises there.
#
# Nothing here is a secret. The values that are secrets in a deployment are commented
# out below, because they belong in the host's dashboard, which is what render.yaml's
# `sync: false` says about each of them.

# Where the app connects, and the one variable nothing works without: app.rb reads it at
# require time, so the app and every rake task fail on its absence before they do
# anything else. A value here wins over the RACK_ENV default in .env.rb, which only the
# Rakefile reads. The test suite is the exception and needs nothing from this file --
# spec_helper names its own database, so what is set here cannot reach it.
export DATABASE_URL="postgres:///tectonic_development"

# development, test, production or staging. The last two are the pair that turn on
# error reporting and insist on a real OAuth signing key instead of a generated one.
export RACK_ENV="development"

# Roda's sessions plugin refuses a secret shorter than 64 bytes, and app.rb builds the
# app at require time, so a short or missing one raises before a single route is
# reached. The value below is long enough and says what it is, so that a deployment
# which somehow ends up carrying it announces the mistake itself rather than running on
# a secret everyone can read. Generate a real one with:
#   ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
export SESSION_SECRET="development-only-session-secret-not-a-real-credential-generate-your-own"

# Seconds a request may hold a thread before rack-timeout raises inside it, 20 unless
# set. Only config.ru reads it, so a `rackup` run takes it and the test suite does not.
# Uncomment the line below before you stop a request in a debugger for longer than that,
# because otherwise the timeout fires while you are reading and the request you were
# looking at is gone.
# export RACK_TIMEOUT_SERVICE_TIMEOUT="0"

# Everything below is for production and staging. Development either generates an
# equivalent at boot or does without, so leave these commented out locally; setting one
# to "" would be worse than leaving it unset, for the reason at the top of this file.

# The RSA private key (PEM) that signs OAuth JWT access tokens, the public half being
# derived from it. Development mints a throwaway pair at boot, which is why the MCP
# specs need no key management; a deployment needs one that is stable across deploys
# and instances, or every access token already issued stops verifying. Generate with
# `openssl genrsa 2048` and paste it into the dashboard, never into a file in this repo.
# export OAUTH_JWT_PRIVATE_KEY=""

# The Sentry project DSN, from Settings -> Projects -> your project -> Client Keys
# (DSN) in Sentry. Read only when RACK_ENV is production or staging; without it the app
# boots and serves with error reporting switched off and says so once on stderr. Leave
# it commented out in development unless you actually want local errors reported to a
# real project, and set it in the host's dashboard for a deployment rather than here.
# export SENTRY_DSN=""

# The canonical https origin the OAuth authorization server and the MCP endpoint
# advertise -- the audience tokens are minted for and the discovery URLs clients follow
# -- and the Host values the MCP transport's DNS-rebinding protection allows beyond
# loopback. Both are needed as soon as the endpoint is reachable from anywhere but this
# machine; locally the defaults cover it. README.md documents the rest of the MCP knobs.
# export MCP_PUBLIC_BASE_URL=""
# export MCP_ALLOWED_HOSTS=""
